{%- set net = salt['pillar.get']('net') -%}
{%- set db = salt['pillar.get']('slurm:db') -%}
# Managed by Salt: salt/states/slurm/files/slurmdbd.conf.j2
#
# Contains the accounting database password, so the file is 0600 slurm:slurm.
# slurmdbd refuses to start if it is readable by anyone else.

AuthType=auth/munge
SlurmUser=slurm

# DbdHost has to match this machine's hostname or slurmdbd exits saying it is
# not configured to run here. DbdAddr is what it binds, and it has to be the
# private address slurmctld reaches it on, not 127.0.1.1.
DbdHost={{ net['controller_host'] }}
DbdAddr={{ net['controller_ip'] }}

LogFile=/var/log/slurm/slurmdbd.log
# Under /run/slurmdbd, for the reason slurm.conf gives for SlurmctldPidFile. The
# packaged unit declares RuntimeDirectory=slurmdbd to match.
PidFile=/run/slurmdbd/slurmdbd.pid
DebugLevel=info

StorageType=accounting_storage/mysql
StorageHost=localhost
StorageUser={{ db['user'] }}
StoragePass={{ db['password'] }}
StorageLoc={{ db['name'] }}
